tests[1]{command,path,scope,timeout_seconds,provenance{author,created_at,source_kind,source_ref}}:
  "npm run build && npm run build:test && node --test --test-name-pattern=\"^(a case opener and first arm on one line do not leak the arm binding past esac|a case opener sharing its first-arm segment does not leak across a later esac line|case-arm scope neighbours remain conservatively refused)$\" test/attestation-union.test.ts",test/attestation-union.test.ts,project,120,pi-agent,"2026-09-01T07:11:39.111Z",local_mutation,fix/refuse-unprovable-publish-bindings
close_reason: "Case-opening segments now establish case context before block-depth and first-arm handling; both fail-open shapes refuse, neighbours stay refused, all gates and the 22-repository fleet scan match expectations."
body: ""
