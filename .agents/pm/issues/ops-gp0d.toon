  - command: "node --input-type=module -e 'import assert from \"node:assert/strict\"; import {readFileSync} from \"node:fs\"; import {execFileSync} from \"node:child_process\"; import {decode} from \"@toon-format/toon\"; const ref=process.env.PM_OPS_REVIEW_REF; const text=(path)=>ref?execFileSync(\"git\",[\"show\",ref+\":\"+path],{encoding:\"utf8\"}):readFileSync(path,\"utf8\"); const item=(id)=>decode(text(\".agents/pm/issues/\"+id+\".toon\")); const main=execFileSync(\"git\",[\"show\",\"origin/main:index.ts\"],{encoding:\"utf8\"}); assert.match(main,/function selfHostsPmChangelog/); execFileSync(\"git\",[\"merge-base\",\"--is-ancestor\",\"78428f5\",\"origin/main\"]); const checks=[ [\"timing remains open\",()=>{const x=item(\"ops-gp0d\");assert.ok([\"open\",\"in_progress\"].includes(x.status));for(const k of [\"closed_at\",\"completed_at\",\"close_reason\"])assert.equal(x[k],undefined);assert.match(x.resolution,/Unresolved/);}], [\"self-hosting closeout matches main\",()=>{const x=item(\"ops-pksh\");for(const k of [\"resolution\",\"close_reason\"]){assert.match(x[k],/self-hosted/);assert.match(x[k],/has_pm_changelog=false/);assert.doesNotMatch(x[k],/artifact lookup/);}}], [\"duplicate excluded from generated changelog\",()=>{assert.equal(item(\"ops-6ocs\").status,\"canceled\");const c=text(\"CHANGELOG.md\");assert.ok(c.includes(\"[ops-gitr]\"));assert.ok(!c.includes(\"[ops-6ocs]\"));assert.ok(!c.includes(\"[ops-gp0d]\"));}], [\"inventory closeout is issue-specific\",()=>{for(const k of [\"resolution\",\"close_reason\"]){assert.match(item(\"ops-fcow\")[k],/malformed/);assert.doesNotMatch(item(\"ops-fcow\")[k],/self-host/);}}], [\"long-gate observed result reflects retained evidence\",()=>{assert.match(item(\"ops-3xyb\").actual_result,/432431/);assert.doesNotMatch(item(\"ops-3xyb\").actual_result,/terminated at 300110/);}] ]; let failures=0; for(const [name,check]of checks){try{check();console.log(\"PASS \"+name);}catch{failures++;console.log(\"FAIL \"+name);}} console.log(\"Tracker review evidence: \"+(checks.length-failures)+\"/\"+checks.length+\" passed\"); process.exitCode=failures?1:0;'"
