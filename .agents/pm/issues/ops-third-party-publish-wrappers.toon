  "env -u PM_PATH -u PM_AUTHOR HOME=$(mktemp -d) GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 bun run release:check",project,codex-agent,"2026-10-14T18:21:53.819Z",local_mutation,feat/third-party-publish-wrappers
  "npm run accept:packed",project,codex-agent,"2026-10-14T18:21:54.504Z",local_mutation,feat/third-party-publish-wrappers
