  npm run coverage,project,codex-sol,"2026-11-20T00:54:33.499Z",local_mutation,fix/release-hook-wrapper-options-bm
  node test/release-heading-full-gate.acceptance.ts,project,codex-sol,"2026-11-20T00:54:36.480Z",local_mutation,fix/release-hook-wrapper-options-bm
