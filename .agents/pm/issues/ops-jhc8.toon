  - command: "PM_PATH=/tmp/pm-ops-jhc8 PM_GLOBAL_PATH=/tmp/pm-ops-jhc8-g node --test --test-name-pattern \"a runner spelled as two words\" test/verify-release-publish-attestation.test.ts"
    scope: project
