  "npm run typecheck && npm run lint && npm test && node --test --test-concurrency=2 test/release-workflow.test.ts test/daily-release-workflow.test.ts test/job-local-npm.test.ts && npm run changelog:check && git diff --check",project,3600,codex-sol,"2026-11-16T15:42:18.237Z",local_mutation,fix/job-local-npm
  "npm run build:test && node --test --test-concurrency=2 test/release-workflow.test.ts test/daily-release-workflow.test.ts && node --test --test-name-pattern=\"no workflow replaces\" test/job-local-npm.test.ts && npm run changelog:check",project,900,codex-sol,"2026-11-16T15:53:15.764Z",local_mutation,fix/job-local-npm
  node --test test/job-local-npm.test.ts,project,1000,codex-sol,"2026-11-16T16:05:42.878Z",local_mutation,fix/job-local-npm
