  .github/release-runtime/package.json,project
  .github/workflows/ci.yml,project
  .github/workflows/daily-release.yml,project
  package.json,project
  test/daily-release-workflow.test.ts,project
  test/release-workflow.test.ts,project
tests[2]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  node --test --test-concurrency=2 test/daily-release-workflow.test.ts test/release-workflow.test.ts test/release-runtime.test.ts,project,pi-agent,"2026-11-07T23:44:55.195Z",local_mutation,fix/release-npm-runtime-reads-lock
  npm run typecheck,project,pi-agent,"2026-11-07T23:44:56.684Z",local_mutation,fix/release-npm-runtime-reads-lock
