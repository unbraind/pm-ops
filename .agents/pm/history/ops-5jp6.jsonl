,"assert_stdout_contains":["pass 1"],"assert_stdout_regex":["fail 0"],"note":"heredoc bodies are tracked per redirection, in the order bash closes them"},{"command":"PM_PATH=/tmp/pm-ops-linked PM_GLOBAL_PATH=/tmp/pm-ops-linked-g node --test --test-name-pattern=\"unset discards a binding the shell no longer passes\" test/verify-release-publish-attestation.test.ts","scope":"project","provenance":{"author":"harness:claude-code","created_at":"2026-08-29T10:28:51.310Z","source_kind":"local_mutation","source_ref":"fix/heredoc-bodies-and-unset-in-scalar-index"},"assert_stdout_contains":["pass 1"],"assert_stdout_regex":["fail 0"],"note":"unset discards a binding the shell no longer passes"},{"command":"PM_PATH=/tmp/pm-ops-linked PM_GLOBAL_PATH=/tmp/pm-ops-linked-g node --test --test-name-pattern=\"a binding is read where the invocation runs, not at the end of the file\" test/verify-release-publish-attestation.test.ts","scope":"project","provenance":{"author":"harness:claude-code","created_at":"2026-08-29T10:28:51.310Z","source_kind":"local_mutation","source_ref":"fix/heredoc-bodies-and-unset-in-scalar-index"},"assert_stdout_contains":["pass 1"],"assert_stdout_regex":["fail 0"],"note":"a binding is read where the invocation runs, not at the end of the file"},{"command":"PM_PATH=/tmp/pm-ops-linked PM_GLOBAL_PATH=/tmp/pm-ops-linked-g node --test --test-name-pattern=\"a later assignment does not attest an earlier publish\" test/verify-release-publish-attestation.test.ts","scope":"project","provenance":{"author":"harness:claude-code","created_at":"2026-08-29T10:28:51.310Z","source_kind":"local_mutation","source_ref":"fix/heredoc-bodies-and-unset-in-scalar-index"},"assert_stdout_contains":["pass 1"],"assert_stdout_regex":["fail 0"],"note":"a later assignment does not attest an earlier publish"}]}],"before_hash":"2d8c20be60c8f3f5af80da398f3021dec1eb4b28b75e76f1cab0383461895ee8","after_hash":"5f74429ea9b01471c285d536b5664acb04dfcce447fb9d92ecfc8311e92f142d","item_hash_version":2,"c