{"hash_algorithm":"sha256","ts":"2026-11-17T08:17:21.282Z","author":"pi-claude","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"af36b60610368fffff35917f","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-b2bs"},{"op":"add","path":"/metadata/title","value":"Tracked dist output predates the merged daily-release source changes, so the first post-merge release pack step fails"},{"op":"add","path":"/metadata/description","value":"The resumed-release heading branch changed daily-release.ts (the calendar-day heading helpers) without rebuilding the tracked dist/ output, and merging main carried main's dist forward. No PR-branch gate enforces dist parity: CI and the quick release gate rebuild before running tests and never compare against the committed build. The daily-release workflow's 'Pack verified release' step enforces parity only on main's release candidate, via git diff --exit-code -- . and the dist/ porcelain check after the release's own release:check build, so the first daily release after this merge would fail there until dist is rebuilt and committed."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":["area:build","area:release"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-17T08:17:21.282Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-17T08:17:21.282Z"},{"op":"add","path":"/metadata/author","value":"pi-claude"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"28e9134c1e4d30b9bc0f2df52aaa48deac41556a6f286f4d713da61b68f194bd","item_hash_version":3,"message":"","event_class":"substantive