{"hash_algorithm":"sha256","ts":"2026-09-28T05:27:25.547Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"acec329f9c06ecc0d6dbecd4","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"high","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.283","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-eys5"},{"op":"add","path":"/metadata/title","value":"Release completeness audit fails a release it just created because the GitHub Release list lags creation"},{"op":"add","path":"/metadata/description","value":"Run 36380519990 (2026-09-28, workflow_dispatch) published pm-ops 2026.9.28 to npm and created GitHub Release v2026.09.28 at 05:15:32Z. The audit started in the same second, read the paginated release list, did not see the new release, and failed the run with 'release tag v2026.09.28 has no corresponding GitHub Release'. The release was complete; the audit read an eventually consistent list. Fix: a release tag missing from the list is read by its tag (repos/<slug>/releases/tags/<tag>) before it counts as missing; only a 404 means absent, any other failure is an unreadable source."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["area:release","quality-gates","release"]},{"op":"add","path":"/metadata/created_at","value":"2026-09-28T05:27:25.547Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-09-28T05:27:25.547Z"},{"op":"add","path":"/metadata/author","value":"claude-hub"},{"op":"add","path":"/metadata/acceptance_criteria","value":"verify passes when the list lacks a release that the by-tag read finds; a 404 by-tag read still fails the audit naming the tag; any other by-tag failure is reported as an unreadable source; only tags the list lacks are read by tag"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"a978621587aad6de10b628e7b9bb74937efaa67e60a6a52541770f1ed2861163","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"a25a767fdaeaf87c5211657057a53775089b2eefce10c0c317f568dfff2fdc4b"}
