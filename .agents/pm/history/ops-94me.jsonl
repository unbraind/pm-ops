{"ts":"2026-08-31T11:48:41.382Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"5a7430c457633e76d82d3790","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-94me"},{"op":"add","path":"/metadata/title","value":"P1: Completeness gate makes a partial release permanent (release:check blocks repair)"},{"op":"add","path":"/metadata/description","value":"Reported by Greptile (P1) and CodeRabbit. The completeness gate is wired into release:check / prepublishOnly, which run before the release job's recovery steps. So when a run publishes to npm or pushes its tag and then fails before completing the triple, the next run hits the gate, is rejected for the incomplete state, and aborts before it can create the missing tag or GitHub Release. The gate would have turned the exact 14-day outage it detects into an outage with no automated way out."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T11:48:41.382Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T11:48:41.382Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"dbf9600b5695bccdb7e097bb67f5e3c50a3202820b6e259fb0c592ee6870029d","item_hash_version":2,"message":""}
