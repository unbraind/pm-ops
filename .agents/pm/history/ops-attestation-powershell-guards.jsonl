{"hash_algorithm":"sha256","ts":"2026-11-08T00:01:38.311Z","author":"pi-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"276e4bb94429562bfe510f67","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-attestation-powershell-guards"},{"op":"add","path":"/metadata/title","value":"Handle PowerShell exit guards without misreading them as publish paths"},{"op":"add","path":"/metadata/description","value":"The repository-wide publish-attestation audit parses a PowerShell conditional such as if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } as an unresolved executable expansion, although it is an exit-status guard and contains no publication. This surfaced in release npm runtime PR #260. The current fix uses explicit Bash for that npm bootstrap; shell-aware PowerShell scanning is a separate follow-up."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-11-08T00:01:38.311Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-08T00:01:38.311Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Recognize or explicitly diagnose PowerShell workflow run blocks without treating an exit guard as a publish command; Retain refusal of dynamic or unattested PowerShell publish paths with must-refuse and must-allow synthetic fixtures; Preserve current Bash attestation protections and prove the regression fails on revert"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"b645e299f8fb66a244ddcb