{"ts":"2026-09-01T07:11:39.139Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"gpt-5.6-sol","agent_model_source":"environment","agent_instance":"76a10258f82cbd2668f2cf21","agent_provenance":{"model":{"value":"gpt-5.6-sol","source":"environment"},"effort":null,"role":null,"topic":null},"op":"tests_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-09-01T07:11:39.139Z"},{"op":"add","path":"/metadata/tests","value":[{"command":"npm run build && npm run build:test && node --test --test-name-pattern=\"^(a case opener and first arm on one line do not leak the arm binding past esac|a case opener sharing its first-arm segment does not leak across a later esac line|case-arm scope neighbours remain conservatively refused)$\" test/attestation-union.test.ts","path":"test/attestation-union.test.ts","scope":"project","timeout_seconds":120,"provenance":{"author":"pi-agent","created_at":"2026-09-01T07:11:39.111Z","source_kind":"local_mutation","source_ref":"fix/refuse-unprovable-publish-bindings"}}]}],"before_hash":"828ac8dd46c38070246809afa37a49a3e56f0e4009cb296d124785dbd752e555","after_hash":"b780aee4be244c687c2f55a1026dad7268b21b42d8538090d2b33e6e09f07ccf","item_hash_version":3,"message":"Record the three-title focused regression run"}
{"ts":"2026-09-01T07:11:40.000Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"gpt-5.6-sol","agent_model_source":"environment","agent_instance":"76a10258f82cbd2668f2cf21","agent_provenance":{"model":{"value":"gpt-5.6-sol","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-09-01T07:11:40.000Z","author":"pi-agent","text":"Red-on-revert proof: I reverted only these two source substitutions in `attestation.ts`: (1) `const caseChange = caseDepthChange(segment); const insideCase = caseDepth > 0 || caseChange > 0;` back to `const insideCase = caseDepth > 0;`; (2) `caseDepth = Math.max(0, caseDepth + caseChange);` back to `caseDepth = Math.max(0, caseDepth + caseDepthChange(segment));`. With that exact revert, the focused run executed 3 tests: both new fail-open tests failed (`failures.length` was 0 instead of 1), while `case-arm scope neighbours remain conservatively refused` passed. Exit was 1, pass 1, fail 2. Restoring only those substitutions produced pass 3, fail 0."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-09-01T07:11:40.000Z"}],"before_hash":"b780aee4be244c687c2f55a1026dad7268b21b42d8538090d2b33e6e09f07ccf","after_hash":"b2a9a4c2856c5049a90994bff3e93173af20ed7d6d416132daf37c9234ad1a26","item_hash_version":3,"message":"Record exact red-on-revert evidence"}
