{"ts":"2026-08-29T03:51:22.137Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"4edd44815634a37e0a42737c","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-29T03:51:22.137Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-08-29T03:51:22.137Z","author":"pi-agent","text":"CodeRabbit found that FLAG=--provenance\\; unescapes to --provenance; inside shellScalars. The semicolon was not in the rejection character class, so the value was stored. When expanded into a publish command, tokenizeCommands splits on the semicolon, so the scan sees --provenance as a flag while the shell passes --provenance; as a literal argument. Fixed by extending the character class to also reject ;, &, |, <, >, {, } after unescaping. Added end-to-end regression test."}]}],"before_hash":"dae94800074e3e962943e8429e4dec8c6b0c0d550f24cc4287d380502997516c","after_hash":"c07b886f7fe0cc28991a40b6e02b5fa35a07bf9a78e75056a8bb6a3a0cd944a6","item_hash_version":2}
