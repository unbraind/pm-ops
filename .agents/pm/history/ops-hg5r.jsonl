{"hash_algorithm":"sha256","ts":"2026-11-10T16:27:14.620Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"34569ddecaea7f35ebc61713","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-hg5r"},{"op":"add","path":"/metadata/title","value":"Daily release coverage gate fails: continuation tests inherit the release job's NPM_PROJECT_PATH"},{"op":"add","path":"/metadata/description","value":"The daily release exports NPM_PROJECT_PATH through GITHUB_ENV before running release:check. test/release-continuation-adapter.test.ts saved and restored that variable but never cleared it, so inside the release job the post-release hook's default-cwd branch (scripts/release-continuation.ts:375, NPM_PROJECT_PATH ?? '.') was never taken, and branch coverage fell to 99.81% (pm-ops release run 42807281840, 2026-11-10). PR CI, which lacks the variable, reported 100%."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["coverage","release","tests"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-10T16:27:14.620Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-10T16:27:14.620Z"},{"op":"add","path":"/metadata/author","value":"claude-orchestrator"},{"op":"add","path":"/metadata/acceptance_criteria","value":"The continuation fixture starts every test with NPM_PROJECT_PATH cleared, like POST_RELEASE_SCRIPT; The coverage gate reaches 100% with NPM_PROJECT_PATH set in the ambient environment"},{"op":"add","path":"/metadata/actual_result","value":"Run release checks: ERROR: Coverage for branches (99.81%) does not meet threshold (100%) for scripts/release-continuation.ts (line 375)."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"35dc257ed4a5f327963a277698d1069de6c48ee4c09924fb315e1d897ab7c178","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"efaf766ff6201fed5f9f66a01df8dabd6af36a02c20fc6bade4337cbda4e331d"}
