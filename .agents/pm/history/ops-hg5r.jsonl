{"hash_algorithm":"sha256","ts":"2026-11-10T17:20:57.591Z","author":"claude-orchestrator","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"34569ddecaea7f35ebc61713","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.322","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-10T17:20:57.590Z","author":"claude-orchestrator","text":"CodeRabbit PRRT_kwDOTOTl1M61z_3F: a regression now sets an ambient NPM_PROJECT_PATH, asserts the fixture callback sees it unset, and asserts the value is restored afterwards. Revert proof: dropping the delete fails it (0/1); with the fix 1/0. Adapter file 63/0, test typecheck clean."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-10T17:20:57.591Z"}],"before_hash":"1a6f914a51e8b4df0ceb4a7cca0ede0e2be3b41ef633c784849e8b3dd525cb99","after_hash":"cfaede252452253e7c1e0797900502cd9577c8d787400763b31fa26e582f873a","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"417ca2750ca3d7e5c91a2dd3e02abf050da9cece862a13f62d6dcef1909c28b5"}
{"hash_algorithm":"sha256","ts":"2026-11-23T20:44:22.425Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"50fbda7191e753d4825499b4","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"update","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-23T20:44:22.425Z"},{"op":"add","path":"/metadata/repro_steps","value":"In the daily release job, NPM_PROJECT_PATH is exported through GITHUB_ENV before the release coverage gate runs (observed in release run 42807281840, 2026-11-10). Run the release coverage gate inside that job: the continuation adapter test inherits the exported NPM_PROJECT_PATH, so the default-cwd branch of scripts/release-continuation.ts is never taken, branch coverage of that script falls to 99.81 percent, and the gate fails with \"Coverage for branches (99.81%) does not meet threshold (100%)\". The same gate reports 100 percent in PR CI, which does not export the variable."}],"before_hash":"cfaede252452253e7c1e0797900502cd9577c8d787400763b31fa26e582f873a","after_hash":"754dc5665ab396d94fbf5cbce9c9c0171d0cf73da3fc5cedb432328026ccac21","item_hash_version":3,"event_class":"maintenance","record_hash_version":1,"record_hash":"813c6b824a0a2f3877746de5361f87eaabe723184a7f51dd6ee5fab2472611a1"}
