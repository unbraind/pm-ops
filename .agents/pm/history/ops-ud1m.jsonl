{"ts":"2026-08-31T11:51:48.244Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"5a7430c457633e76d82d3790","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T11:51:48.244Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-31T11:51:48.244Z","author":"pi-agent","text":"Fix: Replaced 'gh release list -L 500' with fetchGithubReleasesPaginated, which pages through the GitHub releases API 100 at a time (gh api repos/{slug}/releases with per_page and page parameters) until a page returns fewer than a full page or nothing. This collects every release rather than truncating at a fixed cap. Revert-proof: test 'fetchGithubReleasesPaginated collects releases across a page boundary, not just the first page' fails RED when makeFetcher.githubReleases reverts to the capped gh release list -L 500 call."}]}],"before_hash":"60b2bfa17edb8b8dc150c421584e787fe62505c711b0b3293b247a222fcd8702","after_hash":"c7497941d1b29464cb0d57833c2ee9276a27c225aaac09556aad23a4316be08e","item_hash_version":2}
