{"ts":"2026-08-31T11:48:58.987Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"5a7430c457633e76d82d3790","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-ud1m"},{"op":"add","path":"/metadata/title","value":"P2: GitHub Release history truncated by gh release list -L 500 (uncapped reads miss older releases)"},{"op":"add","path":"/metadata/description","value":"Reported by Greptile and Sourcery. scripts/verify-release-completeness.ts:280 uses gh release list -L 500 while the tag and npm-version reads are uncapped. This is a daily-release repository: past 500 releases, older releases are omitted and their otherwise complete tags get reported as missing a GitHub Release — permanently red release:check and prepublishOnly. Paginate until the API reports no further pages (do not simply raise 500 to a bigger number; that reproduces the same bug later)."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T11:48:58.987Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T11:48:58.987Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"d96199a745db636321c137aab0010267d431181b6689acce445368abd74e391f","item_hash_version":2,"message":""}
