{"ts":"2026-08-31T11:51:55.973Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"5a7430c457633e76d82d3790","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T11:51:55.973Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-31T11:51:55.973Z","author":"pi-agent","text":"Fix: Replaced the loose regex (/(?:github\\.com|github)[:/].../) with strict URL parsing. The HTTPS form is parsed with new URL and requires hostname === 'github.com' exactly. The SSH (git@github.com:owner/name) and shorthand (github:owner/name) forms are matched with anchored patterns that require the host literally. Hostile inputs like https://notgithub.com/o/n and https://evil.example/github:o/n are rejected. Revert-proof: test 'repoSlugFromUrl rejects hostile hosts that merely contain github and accepts valid GitHub forms' fails RED when the old substring regex is restored."}]}],"before_hash":"4bd049721dce4b81b0fee54424805d3cdde1de5eb9cda5e2b3a5142e7b1c9ece","after_hash":"7a5d1794e6bf2bbff6beda8d515144ceed81391f1e4984c3f308625390f954c1","item_hash_version":2}
