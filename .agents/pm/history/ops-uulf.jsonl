{"ts":"2026-08-31T16:25:29.586Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"2f46f42141870013feb8f1ab","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"ops-uulf"},{"op":"add","path":"/metadata/title","value":"Converge the pinned pm-cli on 2026.8.31 and repair history hashes"},{"op":"add","path":"/metadata/description","value":"The pm-cli history-hash computation changed between 2026.8.22 and 2026.8.24, so a repo whose history was written by an older pm reports history_drift_chain_mismatch (gate_failing) the moment the pinned pm binary is bumped. This converges the pm-ops pin to @unbrained/pm-cli 2026.8.31 (the fleet-wide target), recomputes the drifted ops-w3ke history stream hash via pm history-repair --all, and reinstalls the pm-ops self-extension against the new binary so the extension_host_pm_cli_version_skew census agrees. The before/after hash chain is intact and no item payloads changed. Upstream: pm-cli#1168."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T16:25:29.586Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T16:25:29.586Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"4bbedba124e1847bb7f5c6e1f2a994980e57426cff8a0f8f255ae5562d4addcb","item_hash_version":3,"message":""}
